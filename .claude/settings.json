{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/clients.toml)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "agent-toolkit": {
      "source": {
        "source": "github",
        "repo": "akoita/agent-toolkit"
      }
    }
  },
  "enabledPlugins": {
    "utilities@agent-toolkit": true
  }
}
